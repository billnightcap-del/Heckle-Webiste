# Copy to .env (git-ignored) for local builds, or add these in your host's build settings.

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics stays off while this is empty.
VITE_GA_ID=

# Beehiiv subscribe form ID, from the form's embed code (the part after embeds.beehiiv.com/).
# The Setlist sign-up shows "Opening soon" while this is empty.
VITE_BEEHIIV_FORM_ID=

# Optional: TMDB v3 API key. Fills in Specials cover art that the bundled poster file and the
# Apple/Wikipedia lookups miss. It ships to the browser.
VITE_TMDB_KEY=
